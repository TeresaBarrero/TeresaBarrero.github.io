---
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/ultra/400.css';
import '@fontsource/bebas-neue/400.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/500.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/600.css';
import '@fontsource/nunito-sans/700.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/caveat/700.css';
import Base from '../layouts/Base.astro';
import ProjectArt from './ProjectArt.astro';
import NetButton from './NetButton.astro';
import LangSwitch from './LangSwitch.astro';
import Contact from './Contact.astro';
import Flecha from './Flecha.astro';
import { render } from 'astro:content';
import { t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
import { getProjects } from '../lib/projects';
import { home, img, projectPath } from '../lib/paths';

interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;
const s = t(lang);
const other = lang === 'es' ? 'en' : 'es';
const list = await getProjects(lang);
const i = list.findIndex((p) => p.data.uid === slug);
const p = list[i];
const next = list[(i + 1) % list.length];
const d = p.data;
const { Content, headings } = await render(p);
// Índice del caso: bloques fijos + secciones (##) del cuerpo + galería
const toc = [
  { id: 'reto', t: s.challenge },
  { id: 'solucion', t: s.solution },
  ...(d.highlights.length ? [{ id: 'claves', t: s.results }] : []),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, t: h.text })),
  ...(d.gallery.length ? [{ id: 'galeria', t: d.galleryTitle ?? s.gallery }] : []),
];
const hasBody = Boolean(p.body && p.body.trim());
const layoutClass = { long: 'g-long', mobile: 'g-mob', post: 'g-post', wide: 'g-wide', full: 'g-full', fit: 'g-full g-fit', social: 'g-soc', browser: 'g-browser' } as const;
// Piezas seguidas con el mismo group forman un bloque con título
const groups = d.gallery.reduce<{ title: string; items: typeof d.gallery }[]>((acc, g) => {
  const t = g.group ?? '';
  const last = acc[acc.length - 1];
  if (last && last.title === t) last.items.push(g); else acc.push({ title: t, items: [g] });
  return acc;
}, []);
const workHref = `${home(lang)}#trabajo`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.lead,
  dateCreated: String(d.year),
  inLanguage: lang,
  creator: { '@type': 'Person', name: profile.name, url: new URL(home(lang), Astro.site).href },
  ...(d.url ? { url: d.url } : {}),
};
---
<Base lang={lang} title={`${d.title} · ${profile.name}`} description={d.lead} alternate={projectPath(other, slug)} jsonLd={jsonLd}>
  <div class={d.theme ? `case-page theme-${d.theme}` : "case-page"}>
    <header class="case-top"><div class="wrap">
      <a class="mono muted" href={workHref} style="text-decoration:none">← {s['case.back']} / {d.title}</a>
      <div class="top-r">
        <LangSwitch lang={lang} alternate={projectPath(other, slug)} />
        <a class="close" href={workHref}><span>{s.close}</span><b aria-hidden="true">✕</b></a>
      </div>
    </div></header>
    <main id="contenido">
      <section class="case-hero wrap">
        <span class="mono muted">{d.type} · {d.year}</span>
        <h1 class="h1"><span class="ln"><span>{d.title}</span></span></h1>
        <p class="lead">{d.lead}</p>
        <div class="case-meta" style={d.duration ? '--n:5' : undefined}>
          <div><span class="mono muted">{s.role2}</span>{d.role}</div>
          <div><span class="mono muted">{s.year}</span>{d.year}</div>
          {d.duration && <div><span class="mono muted">{s.duration}</span>{d.duration}</div>}
          <div><span class="mono muted">{s.services}</span>{d.services}</div>
          <div><span class="mono muted">{s.tools}</span>{d.tools}</div>
        </div>
        <div class={d.art ? "case-cover" : "case-cover is-photo"}><ProjectArt art={d.art} cover={d.cover} /></div>
        {d.demo && <p class="demo-cta"><a class="demo-btn" href={d.demo.url} target="_blank" rel="noopener noreferrer">{s['demo.btn']}<Flecha /></a></p>}
        {d.links.length > 0 && (
          <p class="case-btns case-nets">{d.links.map((l) => <NetButton href={l.href} label={l.label} />)}</p>
        )}
        {d.links.length === 0 && !d.demo && (d.url || d.document) && (
          <p class="case-links">
            {d.url && <a class="mono" href={d.url} target="_blank" rel="noopener">{s.live} <Flecha /></a>}
            {d.document && <a class="mono" href={d.document} target="_blank" rel="noopener noreferrer">{s.doc} <Flecha /></a>}
          </p>
        )}
      </section>
      {d.demo && (
        <section class={d.demo.embed ? 'demo wrap' : 'demo is-link wrap'} id="demo" aria-labelledby="demo-t">
          {!d.demo.embed && d.demo.wide && (
            <a class="demo-win" href={d.demo.url} target="_blank" rel="noopener noreferrer" aria-label={`${s['demo.btn']}: ${d.title}`}>
              <i aria-hidden="true"><b></b><b></b><b></b><span>{d.demo.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span></i>
              <img src={img(d.demo.wide)} alt={`${s['demo.shot']} ${d.title}`} width="1800" height="1125" loading="lazy" decoding="async" />
            </a>
          )}
          {d.demo.embed && <div class="demo-phone">
            {/* En escritorio, la app real dentro de un marco de móvil. No se carga hasta que el visitante pulsa
                el botón (la app es otra web y guarda archivos en su navegador); en el móvil nunca se carga. */}
            <iframe title={`${s['demo.frame']} ${d.title}`} data-src={d.demo.url} width="390" height="844" allow="clipboard-write" hidden></iframe>
            <button type="button" class="demo-load">
              <img src={img(d.demo.shot)} alt="" width="390" height="844" loading="lazy" decoding="async" />
              <span class="demo-btn">{s['demo.load']}</span>
              <small>{s['demo.loadNote']} {new URL(d.demo.url).host}</small>
            </button>
          </div>}
          <img class="demo-shot" src={img(d.demo.shot)} alt={`${s['demo.shot']} ${d.title}`} width="390" height="844" loading="lazy" decoding="async" />
          <div class="demo-side">
            <h2 class="mono muted" id="demo-t">{s['demo.t']}</h2>
            <p class="demo-note">{d.demo.note}</p>
            <p class="demo-cta"><a class="demo-btn" href={d.demo.url} target="_blank" rel="noopener noreferrer">{s['demo.btn']}<Flecha /></a></p>
            {d.demo.qr && <figure class="demo-qr"><img src={img(d.demo.qr)} alt="" width="120" height="120" /><figcaption>{s['demo.qr']}</figcaption></figure>}
          </div>
        </section>
      )}
      <nav class="case-toc wrap" aria-label={s.toc}>
        <span class="mono muted toc-d">{s.toc}</span>
        <h2 class="toc-m">{s.tocM}</h2>
        <ol>{toc.map((x, i) => <li><a href={`#${x.id}`}><b>{String(i + 1).padStart(2, '0')}</b>{x.t}</a></li>)}</ol>
      </nav>
      <section class="case-body wrap">
        <div class="blk" id="reto"><h2 class="mono muted" style="margin:0;font-weight:400">{s.challenge}</h2><p>{d.challenge}</p></div>
        <div class="blk" id="solucion"><h2 class="mono muted" style="margin:0;font-weight:400">{s.solution}</h2><p>{d.solution}</p></div>
        {d.highlights.length > 0 && (
          <div class="blk" id="claves"><h2 class="mono muted" style="margin:0;font-weight:400">{s.results}</h2>
            <div class="metrics">{d.highlights.map((m) => <div class="metric"><b>{m.value}</b><span>{m.label}</span></div>)}</div>
          </div>
        )}
        {hasBody && <div class="case-md"><Content /></div>}
      </section>
      {d.gallery.length > 0 && (
        <section class="wrap" id="galeria">
          <h2 class="mono muted" style="padding-bottom:16px;margin:0;font-weight:400">{d.galleryTitle ?? s.gallery}</h2>
          {groups.map((gr) => (
            <div class="gal-grp">
              {gr.title && <h3 class="gal-t">{gr.title}</h3>}
              <div class="gal">{gr.items.map((g) => (
                <>
                  <figure class={layoutClass[g.layout]}><button type="button" class="zoom" aria-label={`${s.zoom}: ${g.alt}`}>{g.layout === 'browser'
                    ? <span class="win"><i aria-hidden="true"><b></b><b></b><b></b></i><img src={img(g.src)} alt={g.alt} loading="lazy" decoding="async" /></span>
                    : <img src={img(g.src)} alt={g.alt} loading="lazy" decoding="async" />}</button><figcaption>{g.alt}</figcaption></figure>
                  {d.more.filter((m) => m.group === gr.title && m.after === g.src).map((m) => (
                    <p class="case-btns gal-more gal-in"><NetButton href={m.href} label={m.label} />{m.note && <span class="gal-note">{m.note}</span>}</p>
                  ))}
                </>
              ))}</div>
              {d.url && gr.items.some((g) => g.layout === 'long') && <p class="case-btns web-full"><NetButton href={d.url} label={s.webFull} /></p>}
              {d.more.some((m) => m.group === gr.title && !m.after) && (
                <p class="case-btns gal-more">{d.more.filter((m) => m.group === gr.title && !m.after).map((m) => <NetButton href={m.href} label={m.label} />)}</p>
              )}
            </div>
          ))}
        </section>
      )}
      {d.gallery.length > 0 && (
        <dialog class="lb" id="lb" aria-label={s.zoom}>
          <button type="button" class="lb-x" id="lbClose" aria-label={s.closeImg}>✕</button>
          <div class="lb-sc" id="lbSc"><img id="lbImg" alt="" /></div>
          <p class="lb-cap mono" id="lbCap"></p>
        </dialog>
      )}
      {d.demo && (
        <div class="wrap demo-end"><p class="demo-end-t">{s['demo.end']}</p><p class="demo-cta"><a class="demo-btn" href={d.demo.url} target="_blank" rel="noopener noreferrer">{s['demo.btn']}<Flecha /></a></p></div>
      )}
      {d.document && <a class="fab" style={d.accent ? `--fab:${d.accent}` : undefined} href={d.document} target="_blank" rel="noopener noreferrer">{s.docBtn}<Flecha /></a>}
      {list.length > 1 && (
        <div class="wrap"><a class="next" href={projectPath(lang, next.data.uid)}><span class="mono muted">{s.next}</span><br /><span class="t">{next.data.title} <span aria-hidden="true">→</span></span></a></div>
      )}
    </main>
    <Contact lang={lang} />
  </div>
</Base>

<script>
  // Botón fijo «Ver proyecto completo»: si pasa por encima de un fondo de su mismo color (o de poco contraste),
  // se invierte (fondo blanco y texto del color del proyecto) para que se siga viendo.
  const fab = document.querySelector<HTMLElement>('.fab');
  if (fab) {
    const rgb = (c: string) => {
      const m = c.match(/^rgba?\(([^)]+)\)$/);
      if (!m) return null;
      const v = m[1].split(/[\s,/]+/).filter(Boolean).map(Number);
      return v.length >= 3 && (v.length < 4 || v[3] > 0.5) ? v.slice(0, 3) : null;
    };
    const lum = (c: number[]) => {
      const f = (x: number) => ((x /= 255) <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4);
      return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
    };
    const contraste = (a: number[], b: number[]) => {
      const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
      return (x + 0.05) / (y + 0.05);
    };
    const propio = rgb(getComputedStyle(fab).backgroundColor);
    const fondoEn = (x: number, y: number) => {
      for (const el of document.elementsFromPoint(x, y)) {
        if (fab.contains(el)) continue;
        const c = rgb(getComputedStyle(el).backgroundColor);
        if (c) return c;
      }
      return null;
    };
    let pendiente = false;
    const revisar = () => {
      pendiente = false;
      if (!propio) return;
      const r = fab.getBoundingClientRect();
      const y = r.top + r.height / 2;
      const choca = [0.12, 0.5, 0.88].some((p) => {
        const c = fondoEn(r.left + r.width * p, y);
        return c !== null && contraste(c, propio) < 1.6;
      });
      fab.classList.toggle('sobre-color', choca);
    };
    const pedir = () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(revisar); }
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    addEventListener('load', pedir);
    pedir();
  }
</script>
