---
import Base from '../layouts/Base.astro';
import ProjectArt from './ProjectArt.astro';
import NetButton from './NetButton.astro';
import LangSwitch from './LangSwitch.astro';
import Contact from './Contact.astro';
import { render } from 'astro:content';
import { t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
import { getProjects } from '../lib/projects';
import { home, img, projectPath } from '../lib/paths';

interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;
const s = t(lang);
const other = lang === 'es' ? 'en' : 'es';
const list = await getProjects(lang);
const i = list.findIndex((p) => p.data.uid === slug);
const p = list[i];
const next = list[(i + 1) % list.length];
const d = p.data;
const { Content } = await render(p);
const bannerStyle = d.bannerColors ? `--bb:${d.bannerColors.bg};--bf:${d.bannerColors.fg}` : undefined;
const hasBody = Boolean(p.body && p.body.trim());
const layoutClass = { long: 'g-long', mobile: 'g-mob', post: 'g-post', wide: 'g-wide', full: 'g-full', fit: 'g-full g-fit', social: 'g-soc' } as const;
// Piezas seguidas con el mismo group forman un bloque con título
const groups = d.gallery.reduce<{ title: string; items: typeof d.gallery }[]>((acc, g) => {
  const t = g.group ?? '';
  const last = acc[acc.length - 1];
  if (last && last.title === t) last.items.push(g); else acc.push({ title: t, items: [g] });
  return acc;
}, []);
const workHref = `${home(lang)}#trabajo`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.lead,
  dateCreated: String(d.year),
  inLanguage: lang,
  creator: { '@type': 'Person', name: profile.name, url: new URL(home(lang), Astro.site).href },
  ...(d.url ? { url: d.url } : {}),
};
---
<Base lang={lang} title={`${d.title} · ${profile.name}`} description={d.lead} alternate={projectPath(other, slug)} jsonLd={jsonLd}>
  <div class="case-page">
    <div class="case-top"><div class="wrap">
      <a class="mono muted" href={workHref} style="text-decoration:none">← {s['case.back']} / {d.title}</a>
      <div class="top-r">
        <LangSwitch lang={lang} alternate={projectPath(other, slug)} />
        <a class="close" href={workHref}><span>{s.close}</span><b aria-hidden="true">✕</b></a>
      </div>
    </div></div>
    <main id="contenido">
      <section class="case-hero wrap">
        <span class="mono muted">{d.type} · {d.year}</span>
        <h1 class="h1"><span class="ln"><span>{d.title}</span></span></h1>
        <p class="lead">{d.lead}</p>
        <div class="case-meta">
          <div><span class="mono muted">{s.role2}</span>{d.role}</div>
          <div><span class="mono muted">{s.year}</span>{d.year}</div>
          <div><span class="mono muted">{s.services}</span>{d.services}</div>
          <div><span class="mono muted">{s.tools}</span>{d.tools}</div>
        </div>
        <div class={d.art ? "case-cover" : "case-cover is-photo"}><ProjectArt art={d.art} cover={d.cover} /></div>
        {d.links.length > 0 && (
          <p class="case-btns case-nets">{d.links.map((l) => <NetButton href={l.href} label={l.label} />)}</p>
        )}
        {d.links.length === 0 && (d.url || d.document) && (
          <p class="case-links">
            {d.url && <a class="mono" href={d.url} target="_blank" rel="noopener">{s.live}</a>}
            {d.document && <a class="mono" href={d.document} target="_blank" rel="noopener">{s.doc}</a>}
          </p>
        )}
      </section>
      {d.banners[0] && <div class="cbanner" style={bannerStyle} aria-hidden="true"><div class="cbanner-tr">{[0, 1, 2, 3].map(() => <span>{d.banners[0]}</span>)}</div></div>}
      <section class="case-body wrap">
        <div class="blk"><h2 class="mono muted" style="margin:0;font-weight:400">{s.challenge}</h2><p>{d.challenge}</p></div>
        <div class="blk"><h2 class="mono muted" style="margin:0;font-weight:400">{s.solution}</h2><p>{d.solution}</p></div>
        {d.highlights.length > 0 && (
          <div class="blk"><h2 class="mono muted" style="margin:0;font-weight:400">{s.results}</h2>
            <div class="metrics">{d.highlights.map((m) => <div class="metric"><b>{m.value}</b><span>{m.label}</span></div>)}</div>
          </div>
        )}
        {d.banners[1] && <div class="cbanner cbanner-alt" style={bannerStyle} aria-hidden="true"><div class="cbanner-tr">{[0, 1, 2, 3].map(() => <span>{d.banners[1]}</span>)}</div></div>}
        {hasBody && <div class="case-md"><Content /></div>}
      </section>
      {d.banners[2] && <div class="cbanner" style={bannerStyle} aria-hidden="true"><div class="cbanner-tr">{[0, 1, 2, 3].map(() => <span>{d.banners[2]}</span>)}</div></div>}
      {d.gallery.length > 0 && (
        <section class="wrap">
          <h2 class="mono muted" style="padding-bottom:16px;margin:0;font-weight:400">{s.gallery}</h2>
          {groups.map((gr) => (
            <div class="gal-grp">
              {gr.title && <h3 class="gal-t">{gr.title}</h3>}
              <div class="gal">{gr.items.map((g) => (
                <figure class={layoutClass[g.layout]}><button type="button" class="zoom" aria-label={`${s.zoom}: ${g.alt}`}><img src={img(g.src)} alt={g.alt} loading="lazy" decoding="async" /></button>{g.layout === 'long' && <button type="button" class="long-more" data-more={s.longMore} data-less={s.longLess} aria-expanded="false">{s.longMore}<span aria-hidden="true">↓</span></button>}<figcaption>{g.alt}</figcaption></figure>
              ))}</div>
              {d.more.some((m) => m.group === gr.title) && (
                <p class="case-btns gal-more">{d.more.filter((m) => m.group === gr.title).map((m) => <NetButton href={m.href} label={m.label} />)}</p>
              )}
            </div>
          ))}
        </section>
      )}
      {d.gallery.length > 0 && (
        <dialog class="lb" id="lb" aria-label={s.zoom}>
          <button type="button" class="lb-x" id="lbClose" aria-label={s.closeImg}>✕</button>
          <div class="lb-sc" id="lbSc"><img id="lbImg" alt="" /></div>
          <p class="lb-cap mono" id="lbCap"></p>
        </dialog>
      )}
      {d.document && <a class="fab" style={d.accent ? `--fab:${d.accent}` : undefined} href={d.document} target="_blank" rel="noopener">{s.docBtn}<span aria-hidden="true">↗</span></a>}
      {list.length > 1 && (
        <div class="wrap"><a class="next" href={projectPath(lang, next.data.uid)}><span class="mono muted">{s.next}</span><br /><span class="t">{next.data.title} <span aria-hidden="true">→</span></span></a></div>
      )}
    </main>
    <Contact lang={lang} />
  </div>
</Base>
